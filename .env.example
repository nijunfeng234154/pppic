HOST=127.0.0.1
PORT=3333
PUBLIC_URL=http://localhost:3333
DATA_DIR=./data
# 留空则首次启动自动生成，保存在 data/admin-token（不要提交此文件）。
ADMIN_TOKEN=
MAX_UPLOAD_MB=20
STORAGE_LIMIT_MB=10240
COOKIE_SECURE=false
STORAGE_DRIVER=local
# S3 兼容存储：仅在 STORAGE_DRIVER=s3 时必填。使用专用私有桶。
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
