{
  "name": "pppic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "可自托管的通用图床，支持 Web 和 REST API",
  "engines": { "node": ">=24.0.0 <25" },
  "packageManager": "pnpm@10.18.3",
  "devDependencies": { "@playwright/test": "1.65.1" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:http": "node scripts/test-http.js",
    "test:e2e": "playwright test",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/storage.js && node --check public/app.js"
  }
}
